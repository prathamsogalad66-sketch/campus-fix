{
  "name": "sdmcampusfix",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client -- --host 0.0.0.0\"",
    "client": "npm run dev --prefix client -- --host 0.0.0.0",
    "server": "npm run dev --prefix server",
    "postinstall": "npm install --prefix server",
    "build": "npm install --prefix server && npm install --prefix client && npm run build --prefix client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.5",
    "morgan": "^1.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}